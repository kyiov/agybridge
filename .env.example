# ================================================================
# AGYBridge - Environment Configuration Example
# Copy this file to .env and adjust variables as needed
# ================================================================

# ================================================================
# Server Configuration
# ================================================================

# Server listening host
# Default: 0.0.0.0
HOST=0.0.0.0

# Server listening port
# Default: 7861
PORT=7861

# Reverse proxy path prefix (e.g., /AGYBridge)
# Leave empty if proxy already strips prefix
PATH_PREFIX=

# ================================================================
# Authentication & Security
# ================================================================

# API chat access password (for /v1/chat/completions, /v1/messages, etc.)
API_PASSWORD=your_api_password

# Control panel access password (for web interface login)
PANEL_PASSWORD=your_panel_password

# IP Whitelist (Optional)
# Enable whitelist check (true/false)
IP_WHITELIST_ENABLED=false
# Comma or newline separated list of IPs, CIDRs, or IP ranges
IP_WHITELIST=

# Model Name Rewriting (Optional)
MODEL_REWRITE_ENABLED=false
MODEL_REWRITE_RULES=[["^gpt-4$","gemini-2.5-pro"],["^claude-3-5-sonnet.*$","claude-sonnet-4-5"]]

# ================================================================
# Storage Configuration
# ================================================================

# Backend priority: PostgreSQL > Local SQLite
# Leave empty to use local SQLite database at ./creds/credentials.db
# Format: postgresql://user:password@localhost:5432/agybridge
POSTGRESQL_URI=

# Credential directory (for file storage / backups)
CREDENTIALS_DIR=./creds

# ================================================================
# Outbound Proxy & Upstream Endpoints
# ================================================================

# Outbound HTTP/HTTPS/SOCKS5 proxy (Optional)
# Format: http://127.0.0.1:7890 or socks5://127.0.0.1:1080
PROXY=

# Google OAuth2 endpoint
OAUTH_PROXY_URL=https://oauth2.googleapis.com

# Google APIs endpoint
GOOGLEAPIS_PROXY_URL=https://www.googleapis.com

# Google Antigravity backend API endpoint
ANTIGRAVITY_API_URL=https://daily-cloudcode-pa.googleapis.com

# ================================================================
# Error Handling & Rate Limiting
# ================================================================

# Auto-ban credentials that encounter critical errors (e.g. 403)
AUTO_BAN=false
AUTO_BAN_ERROR_CODES=403

# HTTP 429 retry policy
RETRY_429_ENABLED=true
RETRY_429_MAX_RETRIES=5
RETRY_429_INTERVAL=1

# ================================================================
# Logging Configuration
# ================================================================

# Log level: debug, info, warning, error, critical
LOG_LEVEL=info

# Console output logging (1: enabled, 0: quiet)
ENABLE_LOG=1

# ================================================================
# Advanced Features & Stability
# ================================================================

# Maximum auto-continue attempts for anti-truncation models
ANTI_TRUNCATION_MAX_ATTEMPTS=3

# ================================================================
# Per-Account Health Check (Hang & Silent Expiration Prevention)
# ================================================================
# Enable periodic background health checking per account
HEALTH_CHECK_ENABLED=true
# Health check interval in seconds (default: 180 = 3 minutes)
HEALTH_CHECK_INTERVAL=180
# Timeout for health check probe in seconds (default: 10)
HEALTH_CHECK_TIMEOUT=10
# Maximum read wait time for streaming chunks before detecting hung session (default: 60)
STREAM_READ_TIMEOUT=60
# Maximum timeout for non-streaming requests in seconds (default: 60)
REQUEST_TIMEOUT=60

# ================================================================
# Key-Based Fallback (Jalur Ber-Key)
# ================================================================
# Fallback to direct Gemini API key (Google AI Studio) when accounts
# hit rate limits, expire, or hang, ensuring long runs never break.
# Multiple keys can be comma-separated: key1,key2,key3
FALLBACK_ENABLED=true
FALLBACK_API_KEY=
FALLBACK_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Optional model override for fallback (leave empty for automatic mapping)
FALLBACK_MODEL=

